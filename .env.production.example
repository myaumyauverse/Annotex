POSTGRES_USER=annotex
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=annotex_db

API_VERSION=v1

JWT_SECRET=replace-with-long-random-secret
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=replace-with-second-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=https://your-frontend-domain.com

BLOCKCHAIN_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
PROJECT_TREASURY_WALLET=replace-with-your-solana-treasury-wallet
PAYOUT_TOKEN_MINT=

LOG_LEVEL=info

NEXT_PUBLIC_API_BASE_URL=https://api.your-domain.com/api/v1
NEXTAUTH_URL=https://your-frontend-domain.com
NEXTAUTH_SECRET=replace-with-long-random-secret
