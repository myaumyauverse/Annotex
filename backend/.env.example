
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Pooled connection string for app runtime
DATABASE_URL=postgresql://annotex:annotex@localhost:5433/annotex_db?schema=public
# Direct connection string for Prisma CLI (migrate, db push)
DIRECT_URL=postgresql://annotex:annotex@localhost:5433/annotex_db?schema=public
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=annotex
DB_PASSWORD=annotex
DB_NAME=annotex_db

JWT_SECRET=your-secret-key-min-32-characters-long
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your-refresh-secret-key
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:3000

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Solana / Solana Pay (devnet)
BLOCKCHAIN_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
PROJECT_TREASURY_WALLET=your_project_wallet_public_key
PAYOUT_TOKEN_MINT=


MAX_FILE_SIZE=10485760
UPLOAD_PATH=uploads/

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

LOG_LEVEL=info
LOG_FILE_PATH=logs/
