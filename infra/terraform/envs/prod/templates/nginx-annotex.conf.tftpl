server {
    listen 80;
    server_name ${host};

    # multer caps uploads at 10MB (backend/src/config/index.ts); the extra 2MB
    # is headroom for multipart encoding overhead.
    client_max_body_size 12M;

    # NextAuth is part of the Next.js app, not the Express API: its handler is
    # frontend/app/api/auth/[...nextauth]/route.ts. Its routes sit under
    # /api/auth/, which the /api/ rule below would otherwise capture and send to
    # port 5000, where every one of them 404s and sign-in fails with
    # "Authentication failed" followed by a redirect to /api/auth/error.
    #
    # nginx matches the longest prefix rather than the first match, so this takes
    # precedence over /api/ regardless of ordering. No trailing path on
    # proxy_pass, so the full URI is forwarded unchanged.
    location /api/auth/ {
        proxy_pass http://localhost:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        proxy_pass http://localhost:5000/api/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /uploads/ {
        proxy_pass http://localhost:5000/uploads/;
        proxy_set_header Host $host;
    }

    # Health lives at /health, NOT /api/v1/health.
    location = /health {
        proxy_pass http://localhost:5000/health;
        access_log off;
    }

    # Swagger UI API Documentation
    location /api-docs/ {
        proxy_pass http://localhost:5000/api-docs/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /api-docs {
        return 301 /api-docs/;
    }

    location / {
        proxy_pass http://localhost:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
%{ if length(redirect_hostnames) > 0 ~}

# Canonical host is ${host}; everything else redirects here so there is exactly
# one origin. CORS_ORIGIN is a single value, so a browser left on a secondary
# origin while running a bundle that calls the canonical one would be blocked.
#
# certbot rewrites this block to listen 443 and adds the TLS directives, the
# same way it does for the app block above.
server {
    listen 80;
    server_name ${join(" ", redirect_hostnames)};

    return 301 https://${host}$request_uri;
}
%{ endif ~}
